  "bugs": {
    "url": "https://github.com/AntoniotheFuture/ExcelFormulaBeautifier/issues"
  },
  "homepage": "https://github.com/AntoniotheFuture/ExcelFormulaBeautifier#readme",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@eslint/js": "^10.0.1",
    "babel-loader": "^10.1.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.5.0",
    "html-webpack-plugin": "^5.6.7",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  }
