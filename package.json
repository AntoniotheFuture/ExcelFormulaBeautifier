    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntoniotheFuture/ExcelFormulaBeautifier.git"
  },
