{
  "name": "excel-formula-beautifier",
  "version": "2.0.0",
  "description": "Excel Formula Beautifier, make Excel formulas more easy to read.",
  "main": "dist/excel-formula-beautifier.js",
  "module": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/excel-formula-beautifier.umd.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "start": "webpack serve",
    "build": "NODE_ENV=production webpack",
    "build:dev": "NODE_ENV=development webpack",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "build:prod": "NODE_ENV=production webpack",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntoniotheFuture/ExcelFormulaBeautifier.git"
  },
  "keywords": [
    "excel",
    "formula",
    "beautifier",
    "formatter"
  ],
  "author": "Antonio Liang",
  "license": "GPL-3.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/AntoniotheFuture/ExcelFormulaBeautifier/issues"
  },
  "homepage": "https://github.com/AntoniotheFuture/ExcelFormulaBeautifier#readme",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "babel-loader": "^10.1.1",
    "eslint": "^8.57.0",
    "globals": "^15.1.0",
    "html-webpack-plugin": "^5.6.7",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "terser-webpack-plugin": "^5.5.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^5.2.1"
  }
}
